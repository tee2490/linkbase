# Copy to .env.local and fill in real values. Never commit real secrets.

# MongoDB connection string (local, or mongodb+srv://... for Atlas)
MONGODB_URI=mongodb://localhost:27017/linkbase
# QA test database (goes in .env.test, not .env.local). The name must contain "test".
# MONGODB_URI_TEST=mongodb://localhost:27017/linkbase_test
# NextAuth secret, at least 32 characters. Generate with: npx auth secret
AUTH_SECRET=
# Set to true when self-hosting behind a reverse proxy (not needed on Vercel)
# AUTH_TRUST_HOST=true
# OAuth provider credentials (TBD)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
